        "anchors": [
          "CAPACITY-AWARE-PACING"
        ],
        "authority": "Project-owner planning preference",
        "authorityBoundary": "ECONOMICS_NONACADEMIC_PLANNING_AND_RANKING_PREFERENCES_ONLY",
        "confirmedOn": "2026-08-10",
        "effective": {
