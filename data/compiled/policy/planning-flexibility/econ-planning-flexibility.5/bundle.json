        "anchors": [
          "STRATEGY-PREFERENCES"
        ],
        "authority": "Project-owner planning preference",
        "authorityBoundary": "ECONOMICS_PLANNING_STRATEGY_RANKING_ONLY",
        "confirmedOn": "2026-08-09",
        "effective": {
          "from": "2026-08-09",
          "through": null
        },
        "locator": "CP5 Codex task, project-owner messages dated 2026-08-09",
        "reviewer": "Project owner and Economics Department domain expert",
        "sourceId": "OWNER-CONFIRMATION-CP5-2026-08-09",
        "sourceType": "OWNER_CONFIRMATION",
        "statement": "Balanced and Explore the Major remain separate searches. Balanced prefers feasible even pacing. Explore is available only in effective freshman and sophomore contexts, is compared at yearIndex 0 with the selected same-context Balanced plan, must be lighter and materially distinct, and softly prefers a nondecreasing backloaded distribution. Two or three final-year tracked requirements are common and four is acceptable; this is nonblocking planning guidance, not Hanover academic policy.",
        "supersedes": "Earlier owner-approved planning strategy wording and the Explore First public label"
      },
      {
        "anchors": [
          "ONE-YEAR-EARLY-ELIGIBILITY"
        ],
        "authority": "Project-owner product decision",
        "authorityBoundary": "ECONOMICS_NONACADEMIC_PLANNING_STRATEGY_ELIGIBILITY_ONLY",
        "confirmedOn": "2026-08-09",
        "effective": {
          "from": "2026-08-09",
          "through": null
        },
        "locator": "CP7 Codex task, project-owner request dated 2026-08-09",
        "reviewer": "Project owner and Economics Department domain expert",
        "sourceId": "OWNER-CONFIRMATION-CP7-2026-08-09",
        "sourceType": "OWNER_CONFIRMATION",
        "statement": "One Year Early is offered to students whose effective standing is freshman, sophomore, or junior. Junior students see the same one-year-early strategy as Graduate next year. Senior requests are safely normalized to the standard graduation timeline. This is a nonacademic product and strategy-eligibility decision and does not change plan feasibility or academic policy.",
        "supersedes": "The earlier One Year Early strategy contract limited to freshman and sophomore contexts"
      },
      {
        "anchors": [
          "CATALOG-DEFAULT"
        ],
        "authority": "Project-owner product decision",
        "authorityBoundary": "ECONOMICS_CATALOG_DEFAULT_SELECTION_ONLY",
        "confirmedOn": "2026-08-09",
        "effective": {
          "from": "2026-08-09",
          "through": null
        },
        "locator": "CP7 Codex task, project-owner request dated 2026-08-09",
        "reviewer": "Project owner and Economics Department domain expert",
        "sourceId": "OWNER-CONFIRMATION-CP7-CATALOG-DEFAULT-2026-08-09",
        "sourceType": "OWNER_CONFIRMATION",
        "statement": "Ordinary Economics planning uses the latest officially published requirement set that has been independently verified and explicitly activated by the project owner. Discovery alone never activates a new catalog. The current verified and activated default remains 2025-2026.",
        "supersedes": "The owner-designation wording for the same current 2025-2026 default"
      },
