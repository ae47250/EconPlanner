    {
      "sourceId": "OWNER-ECO257-2026-08-05",
      "sourceType": "OWNER_CONFIRMATION",
      "authority": "Economics Department domain policy",
      "authorityBoundary": "ECO_257_REQUIREMENT_ALLOCATION",
      "locator": "Current Codex thread, project-owner message dated 2026-08-05",
      "confirmedOn": "2026-08-05",
      "reviewer": "Project owner and Economics Department domain expert",
      "statement": "ECO 257 may satisfy the Statistics requirement only. ECO 257 must never count as an Economics elective. No advisor override permits elective treatment unless a future separately documented policy explicitly changes this rule.",
      "effective": {
        "from": "2026-08-05",
        "through": null
      },
      "supersedes": "Ambiguous older prose suggesting ECO 257 might receive elective treatment"
    },
    {
      "sourceId": "OWNER-PRELIMINARY-SCHEDULE-2026-09-22",
      "sourceType": "OWNER_CONFIRMATION",
      "authority": "Economics Department planning policy",
      "authorityBoundary": "PRELIMINARY_SCHEDULE_PLANNING_EVIDENCE",
      "locator": "Current Codex task, department chair and project-owner approval dated 2026-09-22",
      "confirmedOn": "2026-09-22",
      "reviewer": "Economics Department chair and EconPlanner project owner",
      "statement": "A dated preliminary schedule may guide course-to-term planning only for its documented academic year, terms, and courses. Its omissions do not prove non-offering or block a plan. It supplies no verified section or seat information. Without such evidence, a labeled term-level workload projection is permitted but does not assert an actual offering. A verified exact schedule supersedes preliminary evidence within its covered scope; saved plans must be revalidated when it arrives.",
      "effective": {
        "from": "2026-09-22",
        "through": null
      },
      "supersedes": "Earlier academic-year-TBC-only wording for unpublished offering projections"
    },
    {
      "sourceId": "OWNER-ECO461-CHRONOLOGY-2026-08-09",
      "sourceType": "OWNER_CONFIRMATION",
      "authority": "Economics Department domain policy",
      "authorityBoundary": "ECO_461_INTERMEDIATE_CONCURRENCY_CHRONOLOGY",
      "locator": "Current Codex thread, project-owner message dated 2026-08-09",
      "confirmedOn": "2026-08-09",
      "reviewer": "Project owner and Economics Department domain expert",
      "statement": "For the existing ECO 461 concurrency exception, exactly one of ECO 213 or ECO 214 must be successfully completed before the target ECO 461 term. Eligible completed and accepted-transfer evidence, a current in-progress course finishing before the target term, and an earlier generated-term course may count. Same-term or later courses and uncertain or unaccepted history, equivalency, substitution, waiver, or prerequisite evidence do not count. Earlier in-progress or planned completion remains conditional on success. This clarifies the existing 2026-08-01 department-confirmed exception and creates no new exception or alternate planning mode.",
      "effective": {
        "from": "2026-08-09",
        "through": null
      },
      "supersedes": "Ambiguous use of already completed in the 2026-08-01 ECO 461 concurrency wording"
    },
