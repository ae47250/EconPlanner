{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://econplanner.local/schema/schedule-release.v1.schema.json",
  "title": "EconPlanner schedule release",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "schemaVersion", "academicYear", "releaseStatus", "authority", "sourceRefs", "effectiveDate", "supersedes", "terms"],
  "properties": {
    "releaseId": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "1.0.0"},
    "academicYear": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$"},
    "releaseStatus": {"enum": ["DRAFT", "ACTIVE", "SUPERSEDED"]},
    "authority": {"enum": ["REGISTRAR_OR_VERIFIED_DEPARTMENT_SOURCE"]},
    "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "effectiveDate": {"type": "string", "format": "date"},
    "supersedes": {"type": ["string", "null"]},
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["termId", "canonicalTerm", "sourceAliases", "displayLabel", "coverage", "sections"],
        "properties": {
          "termId": {"type": "string", "pattern": "^[0-9]{4}-(FALL|WINTER|MAY|SUMMER)$"},
          "canonicalTerm": {"enum": ["FALL", "WINTER", "MAY", "SUMMER"]},
          "sourceAliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "displayLabel": {"type": "string", "minLength": 1},
          "coverage": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE", "UNKNOWN"]},
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sectionId", "course", "offeringExistence", "enrollmentState", "meeting", "sourceRefs"],
              "properties": {
                "sectionId": {"type": "string", "minLength": 1},
                "course": {"type": "string", "minLength": 1},
                "title": {"type": "string"},
                "crossListedAs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "units": {"type": "number", "exclusiveMinimum": 0},
                "offeringExistence": {"enum": ["OFFERED", "NOT_OFFERED", "UNKNOWN"]},
                "enrollmentState": {"enum": ["OPEN", "FULL", "CLOSED", "WAITLISTED", "UNKNOWN", "STALE"]},
                "meeting": {"type": "object"},
                "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
              }
            }
          }
        }
      }
    }
  }
}
