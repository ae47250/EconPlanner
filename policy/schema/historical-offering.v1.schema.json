{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://econplanner.local/schema/historical-offering.v1.schema.json",
  "title": "EconPlanner governed historical-offering evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "activationStatus", "ownerApproval", "method", "records", "reviewCandidates", "conflicts"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "policyVersion": {"type": "string", "minLength": 1},
    "activationStatus": {"enum": ["INACTIVE_NO_APPROVED_DATA", "ACTIVE_OWNER_APPROVED"]},
    "ownerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "reviewer", "approvedOn"],
      "properties": {
        "approved": {"type": "boolean"},
        "reviewer": {"type": ["string", "null"]},
        "approvedOn": {"type": ["string", "null"], "format": "date"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodId", "version", "owner", "veryLowPriorityRule", "otherThresholdsActive"],
      "properties": {
        "methodId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "veryLowPriorityRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumCompleteYears", "maximumYearsOffered"],
          "properties": {
            "minimumCompleteYears": {"const": 6},
            "maximumYearsOffered": {"const": 1}
          }
        },
        "otherThresholdsActive": {"const": false}
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["courseIdentity", "observationPeriod", "completeYears", "yearsOffered", "sections", "termObservations", "annualOfferingRate", "conditionalTermDistribution", "mostRecentOffering", "gaps", "sourceRefs", "provenance", "method", "ownerApproval", "activationStatus", "conflicts"],
        "properties": {
          "courseIdentity": {"type": "string", "pattern": "^[A-Z]{2,5} [0-9]{3}$"},
          "observationPeriod": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fromAcademicYear", "throughAcademicYear"],
            "properties": {
              "fromAcademicYear": {"type": "string"},
              "throughAcademicYear": {"type": "string"}
            }
          },
          "completeYears": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "yearsOffered": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "sections": {"type": "array", "items": {"type": "object"}},
          "termObservations": {"type": "object"},
          "annualOfferingRate": {"type": "number", "minimum": 0, "maximum": 1},
          "conditionalTermDistribution": {"type": "object"},
          "mostRecentOffering": {"type": ["string", "null"]},
          "gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "provenance": {"type": "object"},
          "method": {
            "type": "object",
            "required": ["methodId", "version"],
            "properties": {
              "methodId": {"type": "string"},
              "version": {"type": "string"}
            }
          },
          "ownerApproval": {
            "type": "object",
            "required": ["approved", "reviewer", "approvedOn"],
            "properties": {
              "approved": {"type": "boolean"},
              "reviewer": {"type": ["string", "null"]},
              "approvedOn": {"type": ["string", "null"], "format": "date"}
            }
          },
          "activationStatus": {"enum": ["INACTIVE_REVIEW_CANDIDATE", "ACTIVE_OWNER_APPROVED"]},
          "conflicts": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "reviewCandidates": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "object"}}
  }
}
