{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://econplanner.local/schema/policy-manifest.v1.schema.json",
  "title": "EconPlanner policy manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "program", "catalogApplicability", "status", "authorityHierarchy", "inputs"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "policyVersion": {"type": "string", "minLength": 1},
    "program": {"const": "ECONOMICS"},
    "catalogApplicability": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["DRAFT", "ACTIVE", "SUPERSEDED"]},
    "authorityHierarchy": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "schema"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^policy/"},
          "schema": {"type": ["string", "null"]}
        }
      }
    }
  }
}
