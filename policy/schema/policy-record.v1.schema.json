{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://econplanner.local/schema/policy-record.v1.schema.json",
  "title": "EconPlanner canonical policy record collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "records"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "policyVersion": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/policyRecord"}
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "catalogYears", "courses", "requirements"],
      "properties": {
        "program": {"const": "ECONOMICS"},
        "catalogYears": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "courses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "owner", "boundary"],
      "properties": {
        "kind": {"enum": ["OFFICIAL_CATALOG", "COLLEGE_POLICY", "DEPARTMENT_CONFIRMED", "ACTIVE_EXACT_SCHEDULE", "OWNER_CONFIRMATION", "HISTORICAL_EVIDENCE"]},
        "owner": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "messageKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["student", "advisor", "move", "report"],
      "properties": {
        "student": {"type": "string", "minLength": 1},
        "advisor": {"type": "string", "minLength": 1},
        "move": {"type": "string", "minLength": 1},
        "report": {"type": "string", "minLength": 1}
      }
    },
    "policyRecordBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "schemaVersion", "policyVersion", "family", "ruleType", "classification", "disposition", "status", "scope", "authority", "sourceRefs", "effective", "confidence", "requiredInputs", "requiredEvidence", "override", "condition", "effect", "reasonCode", "messageKeys", "dependencies", "supersedes", "confirmation", "testRefs"],
      "properties": {
        "ruleId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$"},
        "schemaVersion": {"const": "1.0.0"},
        "policyVersion": {"type": "string", "minLength": 1},
        "family": {"enum": ["COURSE", "REQUIREMENT", "PREREQUISITE", "ALLOCATION", "PERMISSION", "TERM", "LOAD", "HISTORY", "SCHEDULE_EVIDENCE"]},
        "ruleType": {"enum": ["coursePrerequisite", "requirementDefinition", "requirementAllocation", "permissionException", "termLoad", "termIdentity", "graduationStanding", "studentHistory", "scheduleEvidence"]},
        "classification": {"enum": ["HARD", "SOFT", "EVIDENCE", "REVIEW"]},
        "disposition": {"enum": ["ENFORCE", "PREFER", "REVIEW", "REFERENCE"]},
        "status": {"enum": ["DRAFT", "ACTIVE", "REVIEW_REQUIRED", "SUPERSEDED", "EXPIRED", "EXCLUDED"]},
        "scope": {"$ref": "#/$defs/scope"},
        "authority": {"$ref": "#/$defs/authority"},
        "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z0-9-]+#.+$"}, "uniqueItems": true},
        "effective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "through"],
          "properties": {"from": {"type": "string", "format": "date"}, "through": {"type": ["string", "null"], "format": "date"}}
        },
        "confidence": {"enum": ["CONFIRMED", "CONFIRMED_PATTERN", "VERIFIED_SOURCE", "REVIEW_REQUIRED"]},
        "requiredInputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "requiredEvidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "override": {
          "type": "object",
          "additionalProperties": false,
          "required": ["permitted", "authority", "requiredEvidence"],
          "properties": {
            "permitted": {"type": "boolean"},
            "authority": {"type": ["string", "null"]},
            "requiredEvidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "condition": {"type": "object"},
        "effect": {"type": "object"},
        "reasonCode": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "messageKeys": {"$ref": "#/$defs/messageKeys"},
        "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "reviewer", "lastReviewDate"],
          "properties": {
            "date": {"type": "string", "format": "date"},
            "reviewer": {"type": "string", "minLength": 1},
            "lastReviewDate": {"type": "string", "format": "date"}
          }
        },
        "testRefs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["positive", "negative", "approval", "reviewState"],
          "properties": {
            "positive": {"type": "array", "items": {"type": "string"}},
            "negative": {"type": "array", "items": {"type": "string"}},
            "approval": {"type": "array", "items": {"type": "string"}},
            "reviewState": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "policyRecord": {
      "allOf": [
        {"$ref": "#/$defs/policyRecordBase"},
        {
          "oneOf": [
            {"type": "object", "properties": {"ruleType": {"const": "coursePrerequisite"}, "family": {"const": "PREREQUISITE"}}},
            {"type": "object", "properties": {"ruleType": {"const": "requirementDefinition"}, "family": {"const": "REQUIREMENT"}}},
            {"type": "object", "properties": {"ruleType": {"const": "requirementAllocation"}, "family": {"const": "ALLOCATION"}}},
            {"type": "object", "properties": {"ruleType": {"const": "permissionException"}, "family": {"const": "PERMISSION"}}},
            {"type": "object", "properties": {"ruleType": {"const": "termLoad"}, "family": {"const": "LOAD"}}},
            {"type": "object", "properties": {"ruleType": {"const": "termIdentity"}, "family": {"const": "TERM"}}},
            {"type": "object", "properties": {"ruleType": {"const": "graduationStanding"}, "family": {"const": "TERM"}}},
            {"type": "object", "properties": {"ruleType": {"const": "studentHistory"}, "family": {"const": "HISTORY"}}},
            {"type": "object", "properties": {"ruleType": {"const": "scheduleEvidence"}, "family": {"const": "SCHEDULE_EVIDENCE"}}}
          ]
        }
      ]
    }
  }
}
