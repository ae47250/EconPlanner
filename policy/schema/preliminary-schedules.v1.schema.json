{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://econplanner.local/schema/preliminary-schedules.v1.schema.json",
  "title": "Dated preliminary course-to-term schedule evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releases"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["releaseId", "academicYear", "issuedOn", "sourceRefs", "terms"],
        "properties": {
          "releaseId": {"type": "string", "minLength": 1},
          "academicYear": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$"},
          "issuedOn": {"type": "string", "format": "date"},
          "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["termId", "courses"],
              "properties": {
                "termId": {"type": "string", "pattern": "^[0-9]{4}-(FALL|WINTER|MAY|SUMMER)$"},
                "courses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
              }
            }
          }
        }
      }
    }
  }
}
