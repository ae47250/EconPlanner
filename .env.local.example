# Server-only EconPlanner -> pdf-creator connection. Never use NEXT_PUBLIC_ for the key.
PDF_CREATION_API_URL=https://your-pdf-creator-deployment.vercel.app
PDF_CREATION_API_KEY=replace_with_at_least_32_random_characters
PDF_CREATION_BYPASS_TOKEN=preview_only_vercel_automation_bypass
PDF_CREATION_ENABLED=false

# Preview/production MCP route: supply a private 32-byte hex key in Vercel.
# The Open in EconPlanner link uses VERCEL_URL unless this public HTTPS origin is set.
ECONPLANNER_MCP_STATE_KEY=replace_with_64_hex_characters
ECONPLANNER_PUBLIC_URL=https://your-econplanner-deployment.vercel.app
